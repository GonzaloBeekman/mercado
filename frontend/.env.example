# URL base del backend, sin /api al final.
# Local: http://192.168.0.207:3000
# Produccion: https://tu-backend.alwaysdata.net
EXPO_PUBLIC_API_URL=

# Client ID OAuth de Google para web.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Client ID OAuth de Google para Android APK.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Client ID OAuth de Google para iOS, si algun dia se usa.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
